# Django Backend Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-saki-akku-birthday-celebration-key-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Ollama LLM Configuration (Target: Apple MacBook Air M4 16GB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
OLLAMA_MAX_TOKENS=512
OLLAMA_KEEP_ALIVE=5m

# Gemini Translation & Multilingual Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TRANSLATION_MODEL=gemini-1.5-flash

# Embedding & Vector Database
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIRECTORY=./data/chroma

# RAG Retrieval Parameters
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.25
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
MAX_CONTEXT_TOKENS=4096

